<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{basics.TeamName}} - {{basics.SprintName}} Progress Update</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --blue: #0076C0;
      --blue-dk: #005287;
      --cyan: #0EBFCA;
      --tint: #F4F8FA;
      --bg: #F5F7F9;
      --paper: #FFFFFF;
      --txt: #2A2C2F;
      --txt2: #788187;
      --bdr: #D5DCE1;
      --grn: #1B6E2A;
      --grn-bg: #EDF7EE;
      --org: #C45000;
      --org-bg: #FFF4EB;
      --red: #B42318;
      --red-bg: #FEF3F2;
      --gray: #4D5961;
      --gray-bg: #F1F4F6;
      --grad: linear-gradient(90deg, #7B0CEA -16.94%, #128ADF 52.91%, #0EBFCA 123.39%);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg);
      color: var(--txt);
      font-family: "Plus Jakarta Sans", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .brand-rail {
      align-items: center;
      background: var(--paper);
      border-bottom: 1px solid var(--bdr);
      display: flex;
      min-height: 34px;
      padding: 7px 32px;
    }

    .brand-rail-logo {
      display: block;
      height: auto;
      max-height: 22px;
      width: min(178px, 48vw);
    }

    .header-bar {
      align-items: center;
      background: var(--paper);
      border-bottom: 1px solid var(--bdr);
      display: flex;
      gap: 12px;
      min-height: 64px;
      padding: 12px 32px;
    }

    .brand-mark {
      display: grid;
      gap: 3px;
      width: 44px;
    }

    .brand-mark span {
      background: var(--blue);
      border-radius: 999px;
      display: block;
      height: 5px;
    }

    .brand-mark span:nth-child(2) {
      background: #0096D6;
      margin-left: 8px;
      width: 34px;
    }

    .brand-mark span:nth-child(3) {
      background: var(--blue-dk);
      width: 24px;
    }

    .header-logo {
      color: var(--blue-dk);
      font-size: .82rem;
      font-weight: 800;
      letter-spacing: -.01em;
      line-height: 1.15;
    }

    .header-logo span {
      color: var(--txt2);
      display: block;
      font-size: .66rem;
      font-weight: 600;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    .hero-wrap {
      padding: 28px 4% 0;
    }

    .hero {
      background: var(--grad);
      border-radius: 40px;
      box-shadow: 0 0 0 10px var(--bg);
      color: #FFFFFF;
      padding: 44px 40px;
      text-align: center;
    }

    .hero-label {
      font-size: .6rem;
      font-weight: 700;
      letter-spacing: .15em;
      margin-bottom: 8px;
      opacity: .62;
      text-transform: uppercase;
    }

    .hero h1 {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -.02em;
      line-height: 1.2;
    }

    .hero .sub {
      font-size: .88rem;
      font-weight: 500;
      margin-top: 6px;
      opacity: .75;
    }

    .hero .rollout {
      background: rgba(255, 255, 255, .16);
      border-radius: 20px;
      display: inline-block;
      font-size: .72rem;
      font-weight: 800;
      letter-spacing: .04em;
      margin-top: 14px;
      padding: 6px 18px;
      text-transform: uppercase;
    }

    .wrap {
      margin: 0 auto;
      max-width: 820px;
      padding: 0 24px 48px;
    }

    .sec {
      padding-top: 40px;
    }

    .sec-label {
      color: var(--blue);
      font-size: .58rem;
      font-weight: 800;
      letter-spacing: .13em;
      margin-bottom: 4px;
      text-transform: uppercase;
    }

    .sec-title {
      font-size: 1.2rem;
      font-weight: 800;
      line-height: 1.3;
      margin-bottom: 16px;
    }

    .summary {
      background: var(--grad);
      border-radius: 20px;
      color: #FFFFFF;
      margin-top: 36px;
      padding: 28px 28px 24px;
    }

    .summary-label {
      font-size: .56rem;
      font-weight: 800;
      letter-spacing: .14em;
      margin-bottom: 14px;
      opacity: .56;
      text-align: center;
      text-transform: uppercase;
    }

    .summary-grid {
      display: grid;
      gap: 10px 22px;
      grid-template-columns: 1fr 1fr;
    }

    .summary-item {
      font-size: .82rem;
      font-weight: 600;
      line-height: 1.5;
      padding: 4px 0 4px 28px;
      position: relative;
    }

    .summary-item::before {
      content: attr(data-icon);
      font-size: .85rem;
      left: 0;
      position: absolute;
      top: 3px;
    }

    .cards {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(3, 1fr);
      margin-bottom: 16px;
    }

    .card {
      background: var(--paper);
      border: 1px solid var(--bdr);
      border-radius: 12px;
      padding: 20px;
    }

    .card:hover {
      box-shadow: 0 2px 12px rgba(0, 0, 0, .06);
    }

    .card-kicker {
      align-items: center;
      color: var(--blue);
      display: flex;
      font-size: .72rem;
      font-weight: 800;
      gap: 8px;
      margin-bottom: 7px;
    }

    .card-icon {
      align-items: center;
      background: var(--tint);
      border: 1px solid #E2E8EE;
      border-radius: 999px;
      display: inline-flex;
      height: 26px;
      justify-content: center;
      min-width: 26px;
      padding: 0 7px;
    }

    .card h4 {
      font-size: .86rem;
      font-weight: 800;
      line-height: 1.3;
      margin-bottom: 6px;
    }

    .card p {
      color: var(--txt2);
      font-size: .78rem;
      line-height: 1.55;
    }

    .metrics {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(4, 1fr);
    }

    .metric {
      background: var(--paper);
      border: 1px solid var(--bdr);
      border-radius: 12px;
      padding: 18px 14px;
      text-align: center;
    }

    .metric-value {
      color: var(--blue);
      font-size: 1.6rem;
      font-weight: 800;
      line-height: 1;
    }

    .metric-value.green { color: var(--grn); }
    .metric-value.orange { color: var(--org); }
    .metric-value.red { color: var(--red); }
    .metric-value.gray { color: var(--gray); }

    .metric-label {
      color: var(--txt2);
      font-size: .68rem;
      font-weight: 700;
      line-height: 1.3;
      margin-top: 5px;
    }

    .bl {
      list-style: none;
      margin-bottom: 16px;
    }

    .bl li {
      color: var(--txt2);
      font-size: .88rem;
      line-height: 1.6;
      padding: 6px 0 6px 20px;
      position: relative;
    }

    .bl li::before {
      background: var(--blue);
      border-radius: 50%;
      content: "";
      height: 6px;
      left: 0;
      position: absolute;
      top: 14px;
      width: 6px;
    }

    .impact {
      align-items: center;
      background: var(--grn-bg);
      border-radius: 10px;
      color: var(--grn);
      display: flex;
      gap: 12px;
      padding: 14px 18px;
    }

    .impact .t {
      font-size: .56rem;
      font-weight: 800;
      letter-spacing: .07em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .impact .m {
      font-size: .84rem;
      font-weight: 700;
      line-height: 1.45;
    }

    .demo {
      background: var(--paper);
      border: 2px dashed var(--bdr);
      border-radius: 10px;
      color: var(--txt2);
      font-size: .84rem;
      line-height: 1.55;
      margin-top: 4px;
      padding: 28px 18px;
      text-align: center;
    }

    .demo strong {
      color: var(--blue);
      display: block;
      font-size: .62rem;
      font-weight: 800;
      letter-spacing: .1em;
      margin-bottom: 6px;
      text-transform: uppercase;
    }

    .next {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .next-row {
      align-items: center;
      background: var(--paper);
      border: 1px solid var(--bdr);
      border-left: 3px solid var(--blue);
      border-radius: 10px;
      display: flex;
      gap: 10px;
      padding: 12px 16px;
    }

    .next-badge {
      border-radius: 4px;
      font-size: .54rem;
      font-weight: 800;
      letter-spacing: .05em;
      min-width: 58px;
      padding: 4px 8px;
      text-align: center;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .badge-qa {
      background: #E8F5E9;
      color: #2E7D32;
    }

    .badge-active {
      background: #E3F2FD;
      color: #1565C0;
    }

    .badge-planned {
      background: var(--tint);
      color: var(--txt2);
    }

    .badge-done {
      background: var(--grn-bg);
      color: var(--grn);
    }

    .next-text {
      color: var(--txt2);
      font-size: .84rem;
      line-height: 1.4;
    }

    .next-text strong {
      color: var(--txt);
    }

    .footer {
      background: #F1F4F6;
      color: var(--txt2);
      font-size: .7rem;
      line-height: 1.5;
      padding: 28px 32px;
      text-align: center;
    }

    .footer-copy {
      color: var(--txt2);
      font-size: .6rem;
      margin-top: 6px;
    }

    @media (max-width: 720px) {
      .brand-rail {
        padding: 7px 20px;
      }

      .header-bar {
        padding: 12px 20px;
      }

      .hero-wrap {
        padding: 0;
      }

      .hero {
        border-radius: 0;
        padding: 32px 20px;
      }

      .hero h1 {
        font-size: 1.55rem;
      }

      .summary-grid,
      .cards,
      .metrics {
        grid-template-columns: 1fr;
      }

      .next-row,
      .impact {
        align-items: flex-start;
        flex-direction: column;
      }
    }

    @page {
      margin: .35in;
      size: letter;
    }

    @media print {
      body {
        background: #FFFFFF;
      }

      .hero {
        box-shadow: none;
        padding: 30px;
      }

      .hero-wrap {
        padding-top: 0;
      }

      .sec {
        padding-top: 24px;
      }

      .summary,
      .card,
      .metric,
      .impact,
      .next-row,
      .demo {
        break-inside: avoid;
      }
    }
  </style>
</head>
<body>
  {{{brandRailHtml}}}

  <header class="header-bar">
    <div class="brand-mark" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div class="header-logo">
      {{basics.TeamName}}
      <span>Sprint Demo</span>
    </div>
  </header>

  <section class="hero-wrap">
    <div class="hero">
      <div class="hero-label">{{basics.TeamName}}</div>
      <h1>{{basics.SprintName}} &mdash; Progress Update</h1>
      <div class="sub">{{basics.DateRange}}</div>
      <div class="rollout">Target Rollout &mdash; {{basics.TargetRollout}}</div>
    </div>
  </section>

  <main class="wrap">
    {{#if hasSummary}}
      <section class="summary">
        <div class="summary-label">{{basics.SprintName}} at a Glance</div>
        <div class="summary-grid">
          {{#each summary}}
            <div class="summary-item" data-icon="{{icon}}">{{text}}</div>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if hasPlatform}}
      <section class="sec">
        <div class="sec-label">Infrastructure &amp; Readiness</div>
        <div class="sec-title">Platform Improvements</div>
        <div class="cards">
          {{#each platform}}
            <article class="card">
              <div class="card-kicker">
                {{#if icon}}<span class="card-icon">{{icon}}</span>{{/if}}
                <span>{{title}}</span>
              </div>
              <p>{{text}}</p>
            </article>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if hasMetrics}}
      <section class="sec">
        <div class="sec-label">Sprint Health</div>
        <div class="sec-title">{{basics.SprintName}} Metrics</div>
        <div class="metrics">
          {{#each metrics}}
            <article class="metric">
              <div class="metric-value {{metricToneClass tone}}">{{value}}</div>
              <div class="metric-label">{{label}}</div>
            </article>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if hasDelivered}}
      {{#each delivered}}
        <section class="sec">
          <div class="sec-label">{{sectionLabel}}</div>
          <div class="sec-title">{{sectionTitle}}</div>
          {{#if bullets}}
            <ul class="bl">
              {{#each bullets}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
          {{/if}}
          {{#if businessValue}}
            <div class="impact">
              <span class="t">Business Value</span>
              <span class="m">{{businessValue}}</span>
            </div>
          {{/if}}
        </section>
      {{/each}}
    {{/if}}

    {{#if hasDemo}}
      <section class="sec">
        <div class="demo">
          <strong>Live Demo</strong>
          {{#each demo}}
            <div>{{this}}</div>
          {{/each}}
        </div>
      </section>
    {{/if}}

    {{#if hasUpNext}}
      <section class="sec">
        <div class="sec-label">Looking Ahead</div>
        <div class="sec-title">Up Next</div>
        <div class="next">
          {{#each upNext}}
            <article class="next-row">
              <span class="next-badge {{badgeClass status}}">{{status}}</span>
              <span class="next-text"><strong>{{title}}</strong>{{#if description}} &mdash; {{description}}{{/if}}</span>
            </article>
          {{/each}}
        </div>
      </section>
    {{/if}}
  </main>

  <footer class="footer">
    {{basics.FooterText}}
    <div class="footer-copy">Generated {{generatedAt}} from the sprint demo workbook.</div>
  </footer>
</body>
</html>
